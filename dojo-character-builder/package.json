{
  "name": "dojo-character-builder",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "dojoPages": {
    "repo": "Noty-chan/dojo-companion"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "deploy:pages": "npm run build && npm --prefix ../dojo-table run build && node ./scripts/deploy-pages.mjs",
    "browsers:install": "node ./scripts/install-playwright-browsers.mjs",
    "qa:portable": "node ./scripts/qa-portable.mjs",
    "generate:reference": "python ../scripts/generate_companion_reference.py",
    "generate:data": "npm run generate:reference && python ../scripts/generate_enemy_roster.py && python ../scripts/generate_builder_data.py",
    "build": "npm run generate:data && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.61.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
